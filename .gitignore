.DS_Store
.venv/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Public upstream sources are pinned in configs/pins.json, not vendored.
vendor/

# Regenerable or scratch-only artifacts.
cache/
data/
checkpoints/
generations/
logs/*.out
logs/*.err
wandb/
artifacts/**/tokenizer/

# Credentials must never enter source control.
.env
*.token
token

# Editor lock files and in-progress generation dumps.
~$*
*.partial.jsonl
